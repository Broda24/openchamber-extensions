{
  "name": "open-calendar",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Lokaler Kalender mit KI-Eingabefeld für OpenChamber",
  "scripts": {
    "build": "node --check panel/main.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "package": "npm run build && python3 scripts/package.py"
  },
  "dependencies": {
    "@openchamber/sdk": "2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.1"
    },
    "contributes": {
      "panel": {
        "id": "open-calendar",
        "name": "OpenCalendar",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "capabilities": ["model"]
    }
  }
}
