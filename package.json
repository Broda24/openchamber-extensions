{
  "name": "openchamber-extensions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "npm run test:browser --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "package": "npm run package --workspaces --if-present",
    "verify:install": "npm run verify:install --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run test:browser && npm run package"
  }
}
